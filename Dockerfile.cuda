# CUDA image: standalone Docker on an NVIDIA GPU (amd64, and arm64 for the GB10).
#   docker build -f Dockerfile.cuda -t kiosk-satellite-ground-control:cuda .
#   docker run --gpus all ...
#
# Each platform runs the CUDA its GPUs need:
#
# - amd64: onnxruntime-gpu 1.29 from ONNX Runtime's CUDA 12 feed, on CUDA 12.9
#   and cuDNN 9. It has kernels for every NVIDIA GPU from Pascal (GTX 10
#   series) to Blackwell (RTX 50 series). The CUDA 13 builds start at Turing.
#   It needs an NVIDIA driver from the 570 series or newer.
# - arm64: onnxruntime-gpu 1.32 from PyPI, on CUDA 13 and cuDNN 9, for the
#   GB10 and other Blackwell boards. ONNX Runtime has no CUDA 12 build for
#   arm64. It needs an NVIDIA driver for CUDA 13 (580 or newer).
#
# NVIDIA's cudnn-runtime image carries every CUDA library, most of them for
# work this service never does: image processing, FFTs, sparse and dense
# solvers, runtime compilation, multi-GPU. Only what ONNX Runtime's CUDA
# provider links (the CUDA runtime, cuBLAS and cuRAND) and cuDNN are copied
# out of it. cuDNN's RNN engines (cudnn_adv) are kept for the Voice Isolator,
# whose LSTMs run on them.
ARG TARGETARCH

FROM nvidia/cuda:12.9.1-cudnn-runtime-ubuntu24.04 AS cuda-amd64
FROM nvidia/cuda:13.0.3-cudnn-runtime-ubuntu24.04 AS cuda-arm64

FROM cuda-${TARGETARCH} AS cuda
RUN mkdir /cuda && cd /usr/local/cuda/lib64 \
    && cp -a libcudart.so.1[23]* libcublas.so.1[23]* libcublasLt.so.1[23]* libcurand.so.10* /cuda/ \
    && cp -a /usr/lib/*-linux-gnu/libcudnn*.so.9* /cuda/

FROM ubuntu:24.04
ARG TARGETARCH

ARG BUILD_VERSION=dev
ARG BUILD_ARCH=""
LABEL org.opencontainers.image.title="Kiosk Satellite Ground Control" \
      org.opencontainers.image.source="https://github.com/jxlarrea/kiosk-satellite-ground-control" \
      org.opencontainers.image.version="${BUILD_VERSION}" \
      io.hass.type="addon" io.hass.name="Kiosk Satellite Ground Control" \
      io.hass.version="${BUILD_VERSION}" io.hass.arch="${BUILD_ARCH}"

# NVIDIA_*: what the NVIDIA container runtime gives the container, the driver
# for compute, as NVIDIA's own images ask.
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 MODELS_DIR=/app/models CUDA=true \
    PIP_BREAK_SYSTEM_PACKAGES=1 NVIDIA_VISIBLE_DEVICES=all NVIDIA_DRIVER_CAPABILITIES=compute,utility

# espeak-ng says how a wake word is pronounced, to find where it ends.
RUN apt-get update && apt-get install -y --no-install-recommends python3 python3-pip espeak-ng \
    && rm -rf /var/lib/apt/lists/*

COPY --from=cuda /cuda/ /usr/local/lib/cuda/
RUN echo /usr/local/lib/cuda > /etc/ld.so.conf.d/cuda.conf && ldconfig

WORKDIR /app
COPY pyproject.toml README.md LICENSE ./
COPY ground_control ./ground_control
# The CPU onnxruntime that pyproject asks for is swapped for the GPU build of
# this platform. TensorRT isn't used: its provider goes too.
RUN pip install --no-cache-dir . && pip uninstall -y onnxruntime \
    && if [ "$TARGETARCH" = "amd64" ]; then \
         pip install --no-cache-dir --no-deps "onnxruntime-gpu==1.29.0" \
           --index-url https://aiinfra.pkgs.visualstudio.com/PublicPackages/_packaging/onnxruntime-cuda-12/pypi/simple/; \
       else \
         pip install --no-cache-dir --no-deps "onnxruntime-gpu>=1.32"; \
       fi \
    && rm -f /usr/local/lib/python3*/dist-packages/onnxruntime/capi/libonnxruntime_providers_tensorrt.so \
    && rm -rf /root/.cache
COPY models/silero_vad.onnx models/redimnet2_b3_multi.onnx models/redimnet2_b1.onnx models/voice_isolator.onnx models/voice_isolator_cpu.onnx \
     models/wake_word_aligner.onnx models/scrfd_2.5g.onnx models/scrfd_10g.onnx models/yolov10n_gestures.onnx \
     models/yolov10x_gestures.onnx models/*.LICENSE.md ./models/

VOLUME /data
EXPOSE 10900
HEALTHCHECK --interval=30s --timeout=5s CMD python3 -c "import urllib.request,os;urllib.request.urlopen(f'http://127.0.0.1:{os.environ.get(\"PORT\",\"10900\")}/health')"
CMD ["python3", "-m", "ground_control"]
